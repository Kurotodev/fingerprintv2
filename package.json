{
  "name": "fingerprintv2",
  "version": "0.1.0",
  "description": "Transparent browser fingerprinting with weighted, change-tolerant matching.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "browser-fingerprint",
    "device-fingerprint",
    "fingerprinting",
    "fraud-prevention"
  ],
  "author": "Kurotodev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kurotodev/fingerprintv2.git"
  },
  "bugs": {
    "url": "https://github.com/Kurotodev/fingerprintv2/issues"
  },
  "homepage": "https://github.com/Kurotodev/fingerprintv2#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
