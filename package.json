{
  "name": "fingerprintv2",
  "version": "0.1.0",
  "description": "Transparent browser fingerprinting with weighted, change-tolerant matching.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fivem": {
      "types": "./dist/fivem.d.ts",
      "import": "./dist/fivem.js",
      "require": "./dist/fivem.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "browser-fingerprint",
    "device-fingerprint",
    "fingerprinting",
    "fivem",
    "nui",
    "fraud-prevention"
  ],
  "author": "Kurotodev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kurotodev/fingerprintv2.git"
  },
  "bugs": {
    "url": "https://github.com/Kurotodev/fingerprintv2/issues"
  },
  "homepage": "https://github.com/Kurotodev/fingerprintv2#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
